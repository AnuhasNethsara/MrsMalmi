# ============================================
# Antigravity Discord Bot - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Required
# ============================================

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token

# Discord application client ID
CLIENT_ID=your_discord_application_client_id

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/antigravity

# Redis connection URL (used for caching, rate limiting, pub/sub)
REDIS_URL=redis://localhost:6379

# Secret key for signing JWT tokens (API authentication)
JWT_SECRET=your_jwt_secret_key

# ============================================
# Optional - Guild ID for development
# ============================================

# Registers commands to a specific guild for instant updates during development
# Leave empty for global command registration (takes up to 1 hour to propagate)
GUILD_ID=

# ============================================
# API Configuration
# ============================================

# Port for the Express API server
API_PORT=3000

# Allowed origin for CORS (dashboard URL)
CORS_ORIGIN=http://localhost:3001

# ============================================
# Discord OAuth2 (for dashboard authentication)
# ============================================

# Discord application client secret
CLIENT_SECRET=your_discord_client_secret

# OAuth2 redirect URI (must match Discord developer portal settings)
OAUTH2_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ============================================
# External APIs (optional)
# ============================================

# VirusTotal API key for scam/phishing link scanning
VIRUSTOTAL_API_KEY=

# Weather API key (e.g., OpenWeatherMap) for /weather command
WEATHER_API_KEY=

# AI provider API key (OpenAI, etc.) for AI features
AI_API_KEY=

# AI provider name (openai, anthropic, etc.)
AI_PROVIDER=openai
